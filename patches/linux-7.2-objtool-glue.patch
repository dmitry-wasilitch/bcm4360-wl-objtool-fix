--- a/Makefile
+++ b/Makefile
@@ -145,7 +145,9 @@
 ccflags-y          += -Wno-date-time
 endif
 
-ldflags-y          := /usr/lib/broadcom-wl-dkms/wlc_hybrid.o_shipped
+# Inject the proprietary object only into the final composite.  A global
+# ldflags-y would also inject it into Kbuild's per-object native-LTO relink.
+LDFLAGS_wl.o       := /usr/lib/broadcom-wl-dkms/wlc_hybrid.o_shipped
 
 KBASE              ?= /lib/modules/`uname -r`
 KBUILD_DIR         ?= $(KBASE)/build
@@ -155,12 +157,22 @@
 CROSS_TOOLS        = /path/to/tools
 CROSS_KBUILD_DIR   = /path/to/kernel/tree
 
+# The proprietary object cannot pass modern whole-module objtool validation.
+# Do not let CONFIG_LTO_CLANG's global delay-objtool setting also suppress
+# objtool for the open-source glue translation units: they contain compiler-
+# generated jumps to __x86_return_thunk and need their own .return_sites/ORC
+# metadata. ThinLTO normally forces delayed whole-module objtool, so compile
+# the four glue objects as ordinary ELF and explicitly process each with the
+# normal delayed-mode (--link) objtool arguments. Keep only the final
+# composite wl.o check disabled, since that is the stage which embeds
+# wlc_hybrid.o_shipped.
+ccflags-y += -fno-lto
+$(wl-objs): override objtool-enabled = y
+
 # Rel. commit "objtool: Always fail on fatal errors" (Josh Poimboeuf, 31 Mar 2025)
-# This is a *ugly* hack to disable objtool during the final processing of wl.o.
-# Since is embeds the proprietary blob (wlc_hybrid.o_shipped), objtool can't
-# process it, as it does not follow the requirements of current kernels,
-# including support for critical security features. As of Linux v6.15+, it causes
-# a build error. Disable it, at your own risk. Note the MIT license applies:
+# The closed object still lacks IBT, RETHUNK, SLS and reliable CFG metadata.
+# This exception is therefore a compatibility boundary, not a claim that the
+# proprietary code has gained modern kernel hardening. Note the MIT license applies:
